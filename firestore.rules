rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      // anyone can send a new order
      allow create: if request.resource.data.type in ['flight', 'membership', 'contact']
                    && request.resource.data.status == 'new'
                    && request.resource.data.customer.name is string
                    && request.resource.data.customer.name.size() < 200
                    && request.resource.data.customer.email is string
                    && request.resource.data.customer.email.size() < 200
                    && request.resource.data.summary is string
                    && request.resource.data.summary.size() < 500;

      // only the admin can read, change or delete orders
      allow read, update, delete: if request.auth != null
                    && request.auth.token.email == 'airlands652@gmail.com';
    }
  }
}
